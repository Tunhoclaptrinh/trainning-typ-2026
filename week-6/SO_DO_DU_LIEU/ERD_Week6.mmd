erDiagram
  users ||--o| profiles : user_id
  users ||--o{ auth_refresh_sessions : user_id
  users ||--o{ templates : author_id
  categories ||--o{ templates : category_id
  users ||--o{ workspaces : owner_id
  users ||--o{ workspace_members : user_id
  workspaces ||--o{ workspace_members : workspace_id
  users ||--o{ workspace_invites : invited_by
  users o|--o{ workspace_invites : accepted_by
  workspaces ||--o{ workspace_invites : workspace_id
  users ||--o{ template_follows : user_id
  templates ||--o{ template_follows : template_id
  templates ||--o{ template_revisions : template_id
  users o|--o{ template_revisions : actor_id
  users ||--o{ notifications : recipient_id
  users o|--o{ notifications : actor_id
  templates o|--o{ notifications : template_id
  message_outbox o|--o{ notifications : event_id
  workspaces ||--o{ workspace_resources : workspace_id
  templates ||--o{ workspace_resources : template_id
  users ||--o{ workspace_resources : added_by
  users {
    uuid id PK
    varchar email UK
    varchar password_hash
    varchar role
    boolean is_active
  }
  profiles {
    uuid id PK
    uuid user_id FK,UK
    varchar username UK
    varchar display_name
  }
  categories {
    uuid id PK
    varchar name UK
    varchar slug UK
  }
  templates {
    uuid id PK
    uuid author_id FK
    uuid category_id FK
    varchar title
    varchar slug UK
    jsonb content_json
    int revision
    varchar version
    boolean is_public
  }
  auth_refresh_sessions {
    uuid id PK
    uuid user_id FK
    uuid family_id
    varchar token_hash UK
    timestamptz expires_at
    timestamptz revoked_at
  }
  workspaces {
    uuid id PK
    uuid owner_id FK
    varchar name
    varchar slug UK
    timestamptz deleted_at
  }
  workspace_members {
    uuid workspace_id PK,FK
    uuid user_id PK,FK
    varchar role
    timestamptz created_at
  }
  workspace_invites {
    uuid id PK
    uuid workspace_id FK
    uuid invited_by FK
    uuid accepted_by FK
    varchar email
    varchar role
    varchar token UK
    timestamptz expires_at
    timestamptz accepted_at
  }
  workspace_resources {
    uuid workspace_id PK,FK
    uuid template_id PK,FK
    uuid added_by FK
    varchar permission
  }
  template_revisions {
    uuid template_id PK,FK
    int revision PK
    uuid actor_id FK
    varchar operation
    jsonb snapshot
  }
  template_follows {
    uuid user_id PK,FK
    uuid template_id PK,FK
    timestamptz created_at
  }
  message_outbox {
    uuid id PK
    varchar event_type
    jsonb payload
    timestamptz created_at
    timestamptz published_at
  }
  notifications {
    uuid id PK
    uuid recipient_id FK
    uuid actor_id FK
    uuid template_id FK
    uuid event_id FK
    int revision
    boolean is_read
    timestamptz read_at
  }
